# Copy this file to `.env` and adjust.

# Local: a SQLite file next to the code. Production: your PostgreSQL URL (Neon / Render).
DATABASE_URL=sqlite:///./car_dealership.db

# Generate a strong one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Anyone registering with one of these emails becomes an admin.
ADMIN_EMAILS=admin@dealership.com

# Where the React app runs (comma-separated if more than one).
CORS_ORIGINS=http://localhost:5173
